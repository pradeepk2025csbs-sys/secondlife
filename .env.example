# Razorpay API Credentials (Obtain from Razorpay Dashboard -> Settings -> API Keys)
# In test mode, keys start with 'rzp_test_'
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Payment Mode: 'razorpay' for real/test Razorpay processing, or 'demo' for local development demo
PAYMENT_MODE=demo

# Platform Commission Percentage (e.g. 5 for 5%)
PLATFORM_COMMISSION_PERCENTAGE=5.0

# Flask Secret Key
SECRET_KEY=change-this-in-production-to-a-secure-random-key
